{
  "name": "chip",
  "figmaName": "Chip",
  "summary": "Чипс — фильтр или выбор, без обводки. Невыбранный — серый (preset/chip/fill; в пресете overlay — белый), выбранный — чёрный (background/neutral-deep) с белой подписью.",
  "props": {
    "selected": {
      "kind": "variant",
      "values": [
        "false",
        "true"
      ],
      "default": "false"
    },
    "state": {
      "kind": "variant",
      "values": [
        "default",
        "hover",
        "pressed",
        "disabled"
      ],
      "default": "default"
    },
    "label": {
      "kind": "text",
      "default": "Чипс"
    },
    "leading": {
      "kind": "boolean",
      "default": false,
      "controls": "slot leading"
    },
    "trailing": {
      "kind": "boolean",
      "default": false,
      "controls": "slot trailing"
    }
  },
  "slots": {
    "leading": {
      "kind": "figma-slot",
      "description": "Иконка, аватар."
    },
    "trailing": {
      "kind": "figma-slot",
      "description": "Счётчик, крестик."
    }
  },
  "colors": {
    "off": "preset/chip/fill, подпись content/neutral/primary",
    "on": "background/neutral-deep, подпись content/neutral/on-deep"
  },
  "states": {
    "hover": "слой state: цвет подписи + opacity/10",
    "pressed": "opacity/20",
    "disabled": "opacity/40"
  },
  "layout": {
    "height": "viewport/control/chip/height",
    "padding-x": "viewport/control/chip/padding-x",
    "radius": "viewport/control/chip/radius",
    "gap": "viewport/control/m/gap",
    "font-size": "viewport/control/m/font-size"
  },
  "presets": "default — на странице и островах; overlay — на цветном фоне. Мод коллекции «5 · Preset» на фрейме-родителе."
}
