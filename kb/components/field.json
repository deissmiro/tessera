{
  "name": "field",
  "figmaName": "Field",
  "summary": "Поле ввода. Мягкий стиль: серая заливка без обводки, скругление 16, высота 56, плавающий лейбл (Medium). Фокус — только курсор, без обводки. Ошибка — красная обводка и красный лейбл, заливка обычная. Поля Field/* — отдельные компоненты той же анатомии; кнопки внутри поля белые (ground/ground-2).",
  "props": {
    "state": {
      "kind": "variant",
      "values": [
        "empty",
        "focus",
        "filled",
        "error",
        "disabled"
      ],
      "description": "empty — лейбл крупно как плейсхолдер; focus — лейбл поднят, курсор; filled — лейбл поднят + значение; error — красная обводка (background/status-negative-deep, 1.5) и красный лейбл и подсказка; disabled — opacity/40."
    },
    "label": {
      "kind": "text",
      "default": "Лейбл"
    },
    "value": {
      "kind": "text",
      "default": "Значение"
    },
    "hint": {
      "kind": "text",
      "default": "Подсказка"
    },
    "hasHint": {
      "kind": "boolean",
      "default": false
    },
    "leading": {
      "kind": "boolean",
      "default": false,
      "controls": "slot leading"
    },
    "trailing": {
      "kind": "boolean",
      "default": false,
      "controls": "slot trailing"
    }
  },
  "slots": {
    "leading": {
      "kind": "figma-slot",
      "description": "Иконка, префикс (+7)."
    },
    "trailing": {
      "kind": "figma-slot",
      "description": "Иконка действия, очистка, степпер, шеврон."
    }
  },
  "colors": {
    "field": "background/neutral-soft",
    "error-stroke": "background/status-negative-deep",
    "label": "empty → content/neutral/tertiary; поднятый → content/neutral/secondary; error → content/status-negative/primary",
    "value": "content/neutral/primary",
    "hint": "content/neutral/secondary; error → content/status-negative/primary",
    "button": "ground/ground-2, иконка content/neutral/primary"
  },
  "layout": {
    "height": "viewport/field/height",
    "radius": "viewport/field/radius",
    "padding-x": "viewport/field/padding-x (10)",
    "gap": "viewport/field/gap (0)",
    "label": "viewport/field/label-size (поднятый) / value-size (empty)",
    "value": "viewport/field/value-size",
    "hint": "viewport/field/hint-size, отступ viewport/field/hint-gap",
    "width": "viewport/field/width",
    "text-padding": "viewport/field/text-padding-x (6) — боковой отступ текстового блока",
    "label-gap": "viewport/field/label-gap (4) — между лейблом и значением"
  },
  "fields": {
    "Field/password": "trailing — белая кнопка с глазом",
    "Field/number": "trailing — белые кнопки − и +",
    "Field/search": "leading — лупа, trailing — контурный крестик «очистить»",
    "Field/select": "trailing — белая кнопка с шевроном",
    "Field/phone": "leading — белая кнопка с кодом страны (+7)",
    "Field/date": "trailing — белая кнопка с календарём"
  },
  "planned": [
    "Field/textarea — многострочное",
    "Field/code — ввод кода из СМС по ячейкам"
  ]
}
