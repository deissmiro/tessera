{
  "$description": "Модель цвета — источник правды для семантики. tools/theme_gen.py разворачивает её в tokens/theme.json (коллекция «2 · Theme»), руками theme.json не правится. Тема ссылается только на Brand.",
  "groups": {
    "ground": {
      "order": 0,
      "shape": "levels",
      "levels": [
        "ground-1",
        "ground-2"
      ],
      "description": "Земля: два уровня основы. ground-1 — страница, ground-2 — то, что лежит на странице (карточки, панели, секции). Других цветов в земле нет.",
      "steps": {
        "ground-1": [
          "neutral.100",
          "neutral.950"
        ],
        "ground-2": [
          "white",
          "neutral.900"
        ]
      }
    },
    "background": {
      "order": 1,
      "shape": "flat",
      "levels": [
        "pale",
        "soft",
        "deep"
      ],
      "description": "Заливки элементов поверх земли: кнопки, чипы, плашки, бейджи. Плоский набор: <смысл>-<контраст>. Ховер и нажатие — соседний тон; затемнение — static-dark + opacity из Numbers."
    },
    "content": {
      "order": 2,
      "shape": "nested",
      "levels": [
        "primary",
        "secondary",
        "tertiary",
        "on-deep"
      ],
      "description": "Текст и иконки: content/<смысл>/<иерархия>. on-deep — контент поверх background/<смысл>-deep."
    },
    "border": {
      "order": 3,
      "shape": "nested",
      "levels": [
        "pale",
        "soft",
        "deep"
      ],
      "description": "Обводки и разделители: border/<смысл>/<контраст>. deep — граница контрола."
    }
  },
  "meanings": {
    "neutral": {
      "schemes": [
        null
      ],
      "kind": "neutral",
      "description": "Основной нейтральный цвет интерфейса."
    },
    "accent": {
      "schemes": [
        "uno",
        "duo"
      ],
      "kind": "colored",
      "description": "Интерактивный акцент. uno — основной, duo — второй."
    },
    "status": {
      "schemes": [
        "positive",
        "negative"
      ],
      "kind": "colored",
      "description": "Статусы: успех и ошибка."
    },
    "brand": {
      "schemes": [
        "uno",
        "duo"
      ],
      "kind": "colored",
      "description": "Фирменные цвета для промо и айдентики, не для интерактива."
    },
    "static": {
      "schemes": [
        "light",
        "dark"
      ],
      "kind": "static",
      "description": "Не меняются от темы: light всегда светлый, dark всегда тёмный. Для контента поверх фото и медиа."
    },
    "inverse": {
      "schemes": [
        null
      ],
      "kind": "inverse",
      "description": "Инверсный цвет: тосты, тултипы, инверсные плашки. В background и border — один цвет без градаций.",
      "single": {
        "background": [
          "neutral.900",
          "neutral.100"
        ],
        "border": [
          "neutral.700",
          "neutral.300"
        ]
      },
      "exclude": {
        "content": [
          "on-deep"
        ]
      }
    }
  },
  "availability": {
    "$description": "Какие смыслы есть в группе. Ground описан своими уровнями и смыслов не имеет.",
    "background": [
      "neutral",
      "accent",
      "status",
      "brand",
      "static",
      "inverse"
    ],
    "content": [
      "neutral",
      "accent",
      "status",
      "brand",
      "static",
      "inverse"
    ],
    "border": [
      "neutral",
      "accent",
      "status",
      "static",
      "inverse"
    ]
  },
  "steps": {
    "$description": "Пары [светлая, тёмная]. Для цветных смыслов — тоны бренда: pale, soft, pure, deep, on-pure. Для нейтральных — ступени neutral.N. white / black — белый и чёрный. Альфы нет: прозрачность — opacity из коллекции Numbers.",
    "neutral": {
      "background": {
        "pale": [
          "neutral.50",
          "neutral.850"
        ],
        "soft": [
          "neutral.100",
          "neutral.800"
        ],
        "deep": [
          "neutral.900",
          "neutral.100"
        ]
      },
      "content": {
        "primary": [
          "neutral.950",
          "neutral.50"
        ],
        "secondary": [
          "neutral.800",
          "neutral.200"
        ],
        "tertiary": [
          "neutral.700",
          "neutral.300"
        ],
        "on-deep": [
          "neutral.50",
          "neutral.950"
        ]
      },
      "border": {
        "pale": [
          "neutral.100",
          "neutral.850"
        ],
        "soft": [
          "neutral.200",
          "neutral.800"
        ],
        "deep": [
          "neutral.500",
          "neutral.500"
        ]
      }
    },
    "colored": {
      "background": {
        "pale": [
          "pale",
          "deep"
        ],
        "soft": [
          "soft",
          "deep"
        ],
        "deep": [
          "pure",
          "pure"
        ]
      },
      "content": {
        "primary": [
          "deep",
          "pale"
        ],
        "secondary": [
          "pure",
          "soft"
        ],
        "on-deep": [
          "on-pure",
          "on-pure"
        ]
      },
      "border": {
        "pale": [
          "pale",
          "deep"
        ],
        "soft": [
          "soft",
          "pure"
        ],
        "deep": [
          "pure",
          "pure"
        ]
      }
    },
    "static": {
      "light": {
        "background": {
          "pale": [
            "white",
            "white"
          ],
          "soft": [
            "neutral.100",
            "neutral.100"
          ],
          "deep": [
            "neutral.200",
            "neutral.200"
          ]
        },
        "content": {
          "primary": [
            "white",
            "white"
          ],
          "secondary": [
            "neutral.200",
            "neutral.200"
          ],
          "tertiary": [
            "neutral.400",
            "neutral.400"
          ],
          "on-deep": [
            "neutral.950",
            "neutral.950"
          ]
        },
        "border": {
          "pale": [
            "neutral.100",
            "neutral.100"
          ],
          "soft": [
            "neutral.300",
            "neutral.300"
          ],
          "deep": [
            "white",
            "white"
          ]
        }
      },
      "dark": {
        "background": {
          "pale": [
            "neutral.800",
            "neutral.800"
          ],
          "soft": [
            "neutral.900",
            "neutral.900"
          ],
          "deep": [
            "neutral.950",
            "neutral.950"
          ]
        },
        "content": {
          "primary": [
            "neutral.950",
            "neutral.950"
          ],
          "secondary": [
            "neutral.800",
            "neutral.800"
          ],
          "tertiary": [
            "neutral.700",
            "neutral.700"
          ],
          "on-deep": [
            "white",
            "white"
          ]
        },
        "border": {
          "pale": [
            "neutral.800",
            "neutral.800"
          ],
          "soft": [
            "neutral.700",
            "neutral.700"
          ],
          "deep": [
            "neutral.950",
            "neutral.950"
          ]
        }
      }
    }
  },
  "pairs": {
    "$description": "Обязательный контраст. Имена — как в Figma. {m} подставляет каждый цветной смысл-схему (accent-uno, status-negative, …), {g} — ground-1 и ground-2. severity warn не ломает сборку.",
    "rules": [
      {
        "fg": "content/neutral/primary",
        "bg": "ground/{g}",
        "min": 7
      },
      {
        "fg": "content/neutral/secondary",
        "bg": "ground/{g}",
        "min": 4.5
      },
      {
        "fg": "content/neutral/tertiary",
        "bg": "ground/{g}",
        "min": 4.5
      },
      {
        "fg": "content/neutral/primary",
        "bg": "background/neutral-soft",
        "min": 7
      },
      {
        "fg": "content/neutral/on-deep",
        "bg": "background/neutral-deep",
        "min": 7
      },
      {
        "fg": "content/inverse/primary",
        "bg": "background/inverse",
        "min": 7
      },
      {
        "fg": "content/static-light/primary",
        "bg": "background/static-dark-deep",
        "min": 7
      },
      {
        "fg": "content/static-dark/primary",
        "bg": "background/static-light-pale",
        "min": 7
      },
      {
        "fg": "content/{m}/primary",
        "bg": "ground/ground-2",
        "min": 4.5
      },
      {
        "fg": "content/{m}/primary",
        "bg": "background/{m}-pale",
        "min": 4.5
      },
      {
        "fg": "content/{m}/primary",
        "bg": "background/{m}-soft",
        "min": 4.5
      },
      {
        "fg": "content/{m}/on-deep",
        "bg": "background/{m}-deep",
        "min": 4.5
      },
      {
        "fg": "border/neutral/deep",
        "bg": "ground/ground-2",
        "min": 3
      },
      {
        "fg": "background/{m}-deep",
        "bg": "ground/ground-1",
        "min": 3,
        "severity": "warn",
        "note": "WCAG 1.4.11: заливка контрола отличима от страницы. Для светлых брендов допустимо, если есть читаемый лейбл."
      }
    ]
  }
}
