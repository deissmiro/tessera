{
  "$description": "Модель цвета — источник правды для семантики. tools/theme_gen.py разворачивает её в tokens/theme.json (коллекция «2 · Theme»), руками theme.json не правится. Тема ссылается только на Brand.",
  "groups": {
    "ground": {
      "order": 0,
      "shape": "levels",
      "levels": [
        "page",
        "island"
      ],
      "description": "Земля: цвет страницы и острова на ней — и больше ничего. Остров — любой крупный блок, лежащий на странице (карточка, панель, секция).",
      "steps": {
        "page": [
          "neutral.100",
          "neutral.950"
        ],
        "island": [
          "white",
          "neutral.900"
        ]
      }
    },
    "background": {
      "order": 1,
      "shape": "flat",
      "levels": [
        "pale",
        "soft",
        "deep"
      ],
      "description": "Заливки элементов поверх земли: кнопки, чипы, плашки, бейджи. Плоский набор: <смысл>-<контраст>."
    },
    "over-background": {
      "order": 2,
      "shape": "flat",
      "levels": [
        "pale",
        "soft",
        "deep"
      ],
      "description": "Полупрозрачные слои поверх любой заливки: ховер, нажатие, выделение, затемнение. Плоский набор: <смысл>-<контраст>."
    },
    "content": {
      "order": 3,
      "shape": "nested",
      "levels": [
        "primary",
        "secondary",
        "tertiary",
        "on-deep"
      ],
      "description": "Текст и иконки: content/<смысл>/<иерархия>. on-deep — контент поверх background/<смысл>-deep."
    },
    "border": {
      "order": 4,
      "shape": "nested",
      "levels": [
        "pale",
        "soft",
        "deep"
      ],
      "description": "Обводки и разделители: border/<смысл>/<контраст>. deep — граница контрола."
    }
  },
  "meanings": {
    "neutral": {
      "schemes": [
        null
      ],
      "kind": "neutral",
      "description": "Основной нейтральный цвет интерфейса."
    },
    "accent": {
      "schemes": [
        "uno",
        "duo"
      ],
      "kind": "colored",
      "description": "Интерактивный акцент. uno — основной, duo — второй."
    },
    "status": {
      "schemes": [
        "positive",
        "negative"
      ],
      "kind": "colored",
      "description": "Статусы: успех и ошибка."
    },
    "brand": {
      "schemes": [
        "uno",
        "duo"
      ],
      "kind": "colored",
      "description": "Фирменные цвета для промо и айдентики, не для интерактива."
    },
    "static": {
      "schemes": [
        "light",
        "dark"
      ],
      "kind": "static",
      "description": "Не меняются от темы: light всегда светлый, dark всегда тёмный. Для контента поверх фото и медиа."
    },
    "inverse": {
      "schemes": [
        null
      ],
      "kind": "inverse",
      "description": "Инверсный цвет: тосты, тултипы, инверсные плашки. В background, over-background и border — один цвет без градаций контраста.",
      "single": {
        "background": [
          "neutral.900",
          "neutral.100"
        ],
        "over-background": [
          "white-8",
          "black-8"
        ],
        "border": [
          "neutral.700",
          "neutral.300"
        ]
      },
      "exclude": {
        "content": [
          "on-deep"
        ]
      }
    }
  },
  "availability": {
    "$description": "Какие смыслы есть в группе. Ground описан своими уровнями и смыслов не имеет.",
    "background": [
      "neutral",
      "accent",
      "status",
      "brand",
      "static",
      "inverse"
    ],
    "over-background": [
      "neutral",
      "static",
      "inverse"
    ],
    "content": [
      "neutral",
      "accent",
      "status",
      "brand",
      "static",
      "inverse"
    ],
    "border": [
      "neutral",
      "accent",
      "status",
      "static",
      "inverse"
    ]
  },
  "steps": {
