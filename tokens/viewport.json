{
  "viewport": {
    "$description": "Адаптив: значения по брейкпоинтам s (телефон), m (планшет), l (десктоп). В Figma переключается модом коллекции «4 · Viewport» на фрейме.",
    "screen": {
      "$description": "Размер экрана брейкпоинта — для превью и корневых фреймов.",
      "width": {
        "$type": "number",
        "$modes": {
          "s": 390,
          "m": 834,
          "l": 1440
        },
        "$description": "Ширина экрана."
      },
      "height": {
        "$type": "number",
        "$modes": {
          "s": 844,
          "m": 1112,
          "l": 900
        },
        "$description": "Высота экрана."
      }
    },
    "window": {
      "$description": "Окно поверх страницы: диалог, нижний шит, боковой шит, адаптивное окно.",
      "padding": {
        "$type": "number",
        "$modes": {
          "s": 16,
          "m": 24,
          "l": 24
        },
        "$description": "Внутренний отступ окна."
      },
      "gap": {
        "$type": "number",
        "$modes": {
          "s": 12,
          "m": 16,
          "l": 16
        },
        "$description": "Шаг между шапкой, контентом и действиями."
      },
      "radius": {
        "$type": "number",
        "$modes": {
          "s": 20,
          "m": 24,
          "l": 24
        },
        "$description": "Скругление окна."
      },
      "margin": {
        "$type": "number",
        "$modes": {
          "s": 16,
          "m": 24,
          "l": 32
        },
        "$description": "Отступ диалога от краёв экрана."
      },
      "dialog-max-width": {
        "$type": "number",
        "$modes": {
          "s": 9999,
          "m": 480,
          "l": 560
        },
        "$description": "Максимальная ширина диалога. 9999 — без ограничения (на телефоне диалог тянется на всю ширину минус margin)."
      },
      "sheet-max-width": {
        "$type": "number",
        "$modes": {
          "s": 9999,
          "m": 640,
          "l": 640
        },
        "$description": "Максимальная ширина нижнего шита; на m и l шит центрируется."
      },
      "side-width": {
        "$type": "number",
        "$modes": {
          "s": 390,
          "m": 400,
          "l": 480
        },
        "$description": "Ширина бокового шита. На телефоне — во весь экран."
      },
      "adaptive": {
        "$description": "Адаптивное окно: нижний шит на телефоне, диалог на планшете и десктопе.",
        "centered": {
          "$type": "boolean",
          "$modes": {
            "s": false,
            "m": true,
            "l": true
          },
          "$description": "Окно по центру (диалог). false — прижато к низу (шит)."
        },
        "grabber": {
          "$type": "boolean",
          "$modes": {
            "s": true,
            "m": false,
            "l": false
          },
          "$description": "Показывать грэббер шита."
        },
        "margin": {
          "$type": "number",
          "$modes": {
            "s": 0,
            "m": 24,
            "l": 32
          },
          "$description": "Отступ от краёв экрана."
        },
        "bottom-radius": {
          "$type": "number",
          "$modes": {
            "s": 0,
            "m": 24,
            "l": 24
          },
          "$description": "Скругление нижних углов: у шита 0."
        },
        "max-width": {
          "$type": "number",
          "$modes": {
            "s": 9999,
            "m": 480,
            "l": 560
          },
          "$description": "Максимальная ширина."
        }
      },
      "action-height": {
        "$type": "number",
        "$modes": {
          "s": 56,
          "m": 56,
          "l": 56
        },
        "$description": "Высота кнопок в футере окна."
      },
      "footer-gap": {
        "$type": "number",
        "$modes": {
          "s": 8,
          "m": 8,
          "l": 8
        },
        "$description": "Шаг между элементами футера окна."
      }
    }
  }
}
