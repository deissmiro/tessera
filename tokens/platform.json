{
  "platform": {
    "$description": "Платформа: ios, ios-glass (Liquid Glass), android. Мод на фрейме перестраивает нативные компоненты и Layout.",
    "is-ios": {
      "$type": "boolean",
      "$modes": {
        "ios": true,
        "ios-glass": true,
        "android": false
      },
      "$description": "Слои iOS видимы."
    },
    "is-android": {
      "$type": "boolean",
      "$modes": {
        "ios": false,
        "ios-glass": false,
        "android": true
      },
      "$description": "Слои Android видимы."
    },
    "glass": {
      "$type": "boolean",
      "$modes": {
        "ios": false,
        "ios-glass": true,
        "android": false
      },
      "$description": "Liquid Glass: полупрозрачные поверхности с размытием и светлой кромкой."
    },
    "status-bar": {
      "$description": "Статус-бар.",
      "height": {
        "$type": "number",
        "$modes": {
          "ios": 54,
          "ios-glass": 54,
          "android": 36
        },
        "$description": "Высота статус-бара."
      },
      "padding-x": {
        "$type": "number",
        "$modes": {
          "ios": 32,
          "ios-glass": 32,
          "android": 16
        },
        "$description": "Боковой отступ."
      },
      "font-size": {
        "$type": "number",
        "$modes": {
          "ios": 17,
          "ios-glass": 17,
          "android": 14
        },
        "$description": "Кегль времени."
      }
    },
    "home-indicator": {
      "$description": "Домашний индикатор / навигационная полоса.",
      "height": {
        "$type": "number",
        "$modes": {
          "ios": 34,
          "ios-glass": 34,
          "android": 24
        },
        "$description": "Высота зоны."
      },
      "width": {
        "$type": "number",
        "$modes": {
          "ios": 134,
          "ios-glass": 134,
          "android": 108
        },
        "$description": "Длина полоски."
      },
      "thickness": {
        "$type": "number",
        "$modes": {
          "ios": 5,
          "ios-glass": 5,
          "android": 4
        },
        "$description": "Толщина полоски."
      }
    },
    "keyboard": {
      "$description": "Клавиатура.",
      "padding-x": {
        "$type": "number",
        "$modes": {
          "ios": 3,
          "ios-glass": 6,
          "android": 4
        },
        "$description": "Боковой отступ."
      },
      "padding-top": {
        "$type": "number",
        "$modes": {
          "ios": 8,
          "ios-glass": 10,
          "android": 8
        },
        "$description": "Верхний отступ."
      },
      "padding-bottom": {
        "$type": "number",
        "$modes": {
          "ios": 4,
          "ios-glass": 8,
          "android": 6
        },
        "$description": "Нижний отступ."
      },
      "row-gap": {
        "$type": "number",
        "$modes": {
          "ios": 11,
          "ios-glass": 10,
          "android": 8
        },
        "$description": "Шаг между рядами."
      },
      "key-gap": {
        "$type": "number",
        "$modes": {
          "ios": 6,
          "ios-glass": 6,
          "android": 5
        },
        "$description": "Шаг между клавишами."
      },
      "key-height": {
        "$type": "number",
        "$modes": {
          "ios": 42,
          "ios-glass": 44,
          "android": 46
        },
        "$description": "Высота клавиши."
      },
      "key-radius": {
        "$type": "number",
        "$modes": {
          "ios": 5,
          "ios-glass": 10,
          "android": 6
        },
        "$description": "Скругление клавиши."
      },
      "radius": {
        "$type": "number",
        "$modes": {
          "ios": 0,
          "ios-glass": 28,
          "android": 0
        },
        "$description": "Скругление верхних углов клавиатуры."
      },
      "font-size": {
        "$type": "number",
        "$modes": {
          "ios": 22,
          "ios-glass": 22,
          "android": 20
        },
        "$description": "Кегль букв."
      },
      "bg-opacity": {
        "$type": "number",
        "$modes": {
          "ios": 100,
          "ios-glass": 80,
          "android": 100
        },
        "$description": "Непрозрачность подложки (у Liquid Glass — полупрозрачная)."
      },
      "background": {
        "$type": "color",
        "$modes": {
          "ios": "{theme.background.neutral-soft}",
          "ios-glass": "{theme.background.neutral-soft}",
          "android": "{theme.background.neutral-soft}"
        },
        "$description": "Подложка клавиатуры."
      },
      "key": {
        "$type": "color",
        "$modes": {
          "ios": "{theme.ground.ground-2}",
          "ios-glass": "{theme.ground.ground-2}",
          "android": "{theme.ground.ground-2}"
        },
        "$description": "Клавиша."
      },
      "key-special": {
        "$type": "color",
        "$modes": {
          "ios": "{theme.border.neutral.soft}",
          "ios-glass": "{theme.border.neutral.soft}",
          "android": "{theme.border.neutral.pale}"
        },
        "$description": "Служебная клавиша: shift, удалить, 123."
      }
    }
  }
}
